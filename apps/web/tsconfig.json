{
  "extends": "../../packages/typescript-config/nextjs.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "typeRoots": ["src/shared/types", "./node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@public/*": ["./public/*"],

      "@components": ["src/components/index.ts"],
      "@components/*": ["src/components/*"],

      "@features": ["src/features/index.ts"],
      "@features/*": ["src/features/*"],

      "@api": ["src/api/index.ts"],
      "@api/*": ["src/api/*"],

      "@shared-lib": ["src/shared/lib/index.ts"],
      "@shared-lib/*": ["src/shared/lib/*"],

      "@shared-utils": ["src/shared/utils/index.ts"],
      "@shared-utils/*": ["src/shared/utils/*"],

      "@shared-hooks": ["src/shared/hooks/index.ts"],
      "@shared-hooks/*": ["src/shared/hooks/*"],

      "@shared-config": ["src/shared/config/index.ts"],
      "@shared-config/*": ["src/shared/config/*"],

      "@workspace-styles/*": ["../../packages/ui/src/styles/*"],
      "@workspace-components": ["../../packages/ui/src/components/index.ts"],
      "@workspace-lib": ["../../packages/ui/src/lib/index.ts"],
      "@workspace-hooks": ["../../packages/ui/src/hooks/index.ts"],
      "@workspace-types/*": ["../../packages/types/src/*"],
      "@workspace-config/*": ["../../packages/config/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/config/src/app.ts"
  ],
  "exclude": ["node_modules"]
}
